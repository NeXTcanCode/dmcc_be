MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-strong-secret
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Optional: real DMRC fare lookup used to refine local fare estimates.
# Falls back to local slab calculation if disabled, unreachable, or the
# station pair isn't mapped.
EXTERNAL_FARE_API_URL=https://dmrc-rest-api.vercel.app/api/v1/dmrc/journeys/fare-route
EXTERNAL_FARE_API_ENABLED=true
EXTERNAL_FARE_API_TIMEOUT_MS=3000
